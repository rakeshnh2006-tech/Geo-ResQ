# ── Flask ──────────────────────────────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-32-byte-string

# ── Database ───────────────────────────────────────────────────────────────────
# Dev (SQLite — no setup needed):
DATABASE_URL=sqlite:///georesq_dev.db
# Production (PostgreSQL on Render / IBM Cloud):
# DATABASE_URL=postgresql://user:password@host:5432/georesq

# ── IBM watsonx.ai ─────────────────────────────────────────────────────────────
WATSONX_API_KEY=your-ibm-cloud-api-key
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=your-watsonx-project-id
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2

# ── Google Maps ────────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ── Rate limiting ──────────────────────────────────────────────────────────────
# Use Redis in production: redis://localhost:6379/0
RATELIMIT_STORAGE_URI=memory://

# ── File storage ───────────────────────────────────────────────────────────────
UPLOAD_FOLDER=frontend/static/uploads
PDF_DIR=instance/briefings
