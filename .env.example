# ── Flask ──────────────────────────────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-32-byte-string

# ── Database (IBM Cloud Databases for MySQL) ───────────────────────────────────
# Format: mysql+pymysql://user:password@host:port/dbname?ssl_ca=/path/to/ca.pem
DATABASE_URL=mysql+pymysql://admin:secret@127.0.0.1:3306/georesq

# ── IBM watsonx.ai ─────────────────────────────────────────────────────────────
WATSONX_API_KEY=your-ibm-cloud-api-key
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=your-watsonx-project-id
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2

# ── Google Maps ────────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ── Rate limiting (use Redis URL in production) ────────────────────────────────
RATELIMIT_STORAGE_URI=memory://
