{
  "version": 2,
  "functions": {
    "api/index.py": {
      "includeFiles": "frontend/templates/**"
    }
  },
  "rewrites": [
    {
      "source": "/static/uploads/(.*)",
      "destination": "/api/index?__vercel_path=/static/uploads/$1"
    },
    {
      "source": "/static/(.*)",
      "destination": "/static/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index?__vercel_path=/$1"
    }
  ],
  "env": {
    "FLASK_ENV": "production"
  },
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
